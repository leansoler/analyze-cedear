{
  "name": "analyze-cedear",
  "version": "1.0.0",
  "description": "A Google Cloud Function that calculates the exchange rate for a given asset",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'scripts/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "start:cedear": "npm run build && functions-framework --target=analyzeCedear",
    "start:bond": "npm run build && functions-framework --target=analyzeBond",
    "start:scrap": "npm run build && functions-framework --target=scrapInvertirOnline",
    "db:seed": "ts-node scripts/seed.ts",
    "emu:start": "firebase emulators:start --only firestore --project=demo-merval-analyst",
    "db:seed:emu": "FIRESTORE_EMULATOR_HOST=localhost:8080 npm run db:seed --",
    "test": "jest",
    "gcp-build": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.0.0",
    "@google-cloud/functions-framework": "^5.0.0",
    "@sparticuz/chromium": "^143.0.4",
    "pino": "^10.1.0",
    "puppeteer": "^24.35.0",
    "puppeteer-core": "^24.35.0",
    "yahoo-finance2": "^3.11.2"
  },
  "devDependencies": {
    "@types/jest": "^28.1.8",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^28.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
